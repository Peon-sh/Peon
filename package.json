      "postcss": ">=8.5.18",
      "valibot": ">=1.4.2",
      "brace-expansion": "^5.0.9",
      "ip-address": "^10.3.1",
      "nanoid": ">=3.3.17",
      "deepmerge-ts": ">=8.0.0",
      "mysql2": ">=3.22.0",
      "@grpc/grpc-js": ">=1.14.5"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-react>eslint": "10",
        "eslint-plugin-import>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
