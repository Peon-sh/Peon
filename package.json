    "next": "16.3.6",
    "node-ssh": "^13.2.1",
    "playwright": "^1.63.0",
    "posthog-js": "^1.434.13",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
