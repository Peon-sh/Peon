    "lucide-react": "^1.22.0",
    "next": "16.2.6",
    "node-ssh": "^13.2.1",
    "playwright": "^1.51.1",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.12.0",
