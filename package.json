    "@prisma/client-runtime-utils": "7.10.0",
    "@react-oauth/google": "^0.13.5",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@tanstack/react-query": "^5.103.2",
