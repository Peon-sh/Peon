# =====================================================================
# Peon Pipelines - environment configuration
# Copy this file to `.env` and fill in values.
# NEXT_PUBLIC_* vars are exposed to the browser; keep everything else secret.
# =====================================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL must be reachable from managed servers (peon-ping-pong pushes to ${APP_URL}/api/v1/agents/push).
# Marketing site (peon.sh). Local: http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
PORT=3000

# --- Database (Prisma / pg adapter) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peon-pipelines?schema=public

# --- Auth / JWT ---
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-long-random-string
JWT_KEY=peon-auth-token

# --- Encryption (app-layer secret encryption, AES-256-GCM) ---
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-byte-base64-key

# --- Google sign-in (client ID only; no client secret) ---
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Email of the Peon instance owner — only this user can edit global instance settings.
INSTANCE_OWNER_EMAIL=owner@example.com

# --- Email (OTP / welcome / invitations) — delivered by the worker ---
# test | aws-ses
EMAIL_DRIVER=test
EMAIL_FROM=no-reply@peon.local
EMAIL_FROM_NAME=Peon

# --- Shared AWS credentials (SES, SQS, S3) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Queue (AWS SQS) ---
# Leave SQS_ENDPOINT empty to use real AWS SQS (recommended for local + prod).
# Only set SQS_ENDPOINT if you need a custom SQS-compatible endpoint.
SQS_ENDPOINT=
SQS_REGION=us-east-1
SQS_DEPLOYMENT_QUEUE_URL=
SQS_TASKS_QUEUE_URL=

# --- Worker ---
WORKER_POLL_WAIT_SECONDS=20
WORKER_MAX_CONCURRENCY=5

# --- Object storage (platform S3; falls back to AWS_* credentials) ---
# Used for deployment preview screenshots under deployments/{serviceUuid}/{deploymentId}/preview.png
# and profile avatars under users/{userId}/avatar.* (browser PUT via presigned URL — allow CORS PUT from APP_URL).
# For lifetime-public preview/avatar URLs, allow public GetObject on those prefixes (ACL or bucket policy).
S3_BUCKET=
# Optional overrides (default to AWS_* above):
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Integrations (optional) ---
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
SENTRY_DSN=

# --- Workspace agent chat ---
# Configure LLM API keys per workspace in Settings → LLMs.

# --- Stripe Billing (Peon Cloud; leave empty for free self-host) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Optional lookup-key overrides (defaults match Dashboard prices)
# STRIPE_PRICE_LOOKUP_MONTHLY=peon_pro_monthly
# STRIPE_PRICE_LOOKUP_YEARLY=peon_pro_yearly