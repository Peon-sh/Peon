# =====================================================================
# Peon — environment configuration
#
#   cp .env.example .env
#
# Fill in the REQUIRED block below; everything after it has working
# defaults or is an optional integration.
#
# NEXT_PUBLIC_* vars are exposed to the browser — never put secrets there.
# =====================================================================


# =====================================================================
# REQUIRED — Peon will not start without these
# =====================================================================

# --- Database ---
# Host-based development (`pnpm dev`) uses this value.
# docker-compose.yml overrides it to the `postgres` service automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peon?schema=public

# --- Auth ---
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-long-random-string

# --- Encryption (AES-256-GCM, secrets at rest) ---
# Generate: openssl rand -base64 32
#
# Set this ONCE, before creating any data, and back it up. Changing it makes
# every stored secret — env vars, database passwords, LLM keys, SSH private
# keys — unreadable unless you rotate properly (docs/self-hosting.md).
#
# A NEW installation refuses to start unless this decodes to 32 bytes.
# An EXISTING installation using an older arbitrary key keeps working and
# only warns — upgrading never breaks your data.
ENCRYPTION_KEY=change-me-32-byte-base64-key

# Set ONLY while rotating the key. Decryption falls back to this value, so old
# rows stay readable until `pnpm encryption:rotate` finishes. Remove afterwards.
# ENCRYPTION_KEY_PREVIOUS=


# =====================================================================
# CORE — sensible defaults, change for production
# =====================================================================

# NODE_ENV is deliberately NOT set here.
#
# `pnpm dev` sets it to development on its own, and the Docker images set it to
# production. Putting it in .env would override the image via `env_file` and
# silently run containers in development mode — which also skips the production
# secret checks in src/lib/env.ts. Set it only if you know you need to.

PORT=3000

# Must be reachable FROM your managed servers — the peon-ping-pong agent
# pushes metrics to ${APP_URL}/api/v1/agents/push. `localhost` will not work
# once you connect a real server.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Marketing site (peon.sh). Local: http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001

# Cookie name for the auth JWT.
JWT_KEY=peon-auth-token

# Only this user can edit global instance settings (/profile/instance).
INSTANCE_OWNER_EMAIL=owner@example.com

# --- Docker Compose overrides (used by docker-compose.yml only) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=peon
# POSTGRES_PORT=5432
# DATABASE_URL_DOCKER=postgresql://postgres:postgres@postgres:5432/peon?schema=public


# =====================================================================
# QUEUE
# =====================================================================
# Deploys, backups, scheduled tasks and outbound email all run through a queue.
#
#   postgres  built-in, no AWS account needed. Default for new installations.
#   sqs       AWS SQS. Auto-selected when both queue URLs below are set, so
#             existing installations keep working with no config change.
#
# Leave QUEUE_DRIVER unset to auto-detect.
# QUEUE_DRIVER=postgres

# Only needed for QUEUE_DRIVER=sqs. Leave SQS_ENDPOINT empty for real AWS.
SQS_ENDPOINT=
SQS_REGION=us-east-1
SQS_DEPLOYMENT_QUEUE_URL=
SQS_TASKS_QUEUE_URL=

# --- Worker tuning ---
WORKER_POLL_WAIT_SECONDS=20
WORKER_MAX_CONCURRENCY=5


# =====================================================================
# EMAIL
# =====================================================================
# test     logs the message (and OTP codes) to the worker console
# smtp     any standard SMTP server — the self-host default
# aws-ses  Amazon SES
EMAIL_DRIVER=test

# Required when EMAIL_DRIVER=smtp:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
EMAIL_FROM=no-reply@peon.local
EMAIL_FROM_NAME=Peon


# =====================================================================
# OPTIONAL — integrations
# =====================================================================

# --- Shared AWS credentials (SES, SQS, S3) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Object storage (deployment screenshots, profile avatars) ---
#   local  disk under PEON_DATA_DIR/storage. Default when S3_BUCKET is unset.
#   s3     AWS S3 or any S3-compatible endpoint (MinIO, R2, Spaces).
# Auto-detected; set STORAGE_DRIVER only to override.
# STORAGE_DRIVER=local
# Allow CORS PUT from APP_URL; allow public GetObject on those prefixes for
# lifetime-public URLs.
S3_BUCKET=
# Default to AWS_* above unless overridden:
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Google sign-in (client ID only; no client secret needed) ---
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- GitHub App (git sources, push/PR deploys) ---
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Platform-managed app ("Connect with Peon"):
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY=

# --- Browser SSH terminal (worker/socket.ts) ---
TERMINAL_WS_PORT=8081
TERMINAL_SESSION_MAX_SECONDS=3600
# Full external WS URL, e.g. wss://app.example.com/terminal/ws
NEXT_PUBLIC_TERMINAL_WS_URL=

# --- Stripe billing ---
# Leave empty for free self-hosting: no paywalls, unlimited projects.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_LOOKUP_MONTHLY=peon_pro_monthly
# STRIPE_PRICE_LOOKUP_YEARLY=peon_pro_yearly

# --- Control-plane TLS (single-server) ---
# Domain Peon itself is served on. Enables docker-compose.gateway.yml, which
# routes the control plane through the SAME proxy that serves deployed apps
# instead of a second one fighting for ports 80/443. See docs/tls-and-proxy.md.
# PEON_CONTROL_PLANE_DOMAIN=peon.example.com
# ACME_EMAIL=ops@example.com

# --- Misc ---
SENTRY_DSN=
# DigitalOcean referral shown during onboarding.
NEXT_PUBLIC_DO_REFERRAL_URL=

# --- Workspace agent chat ---
# LLM API keys are configured per workspace in Settings → LLMs, not here.
